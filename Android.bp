package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_certificate {
    name: "libredialer_cert",
    certificate: "certs/libredialer",
}

android_app {
    name: "Dialer",
    aaptflags: [
        "--auto-add-overlay",
        "--extra-packages org.librelab.contacts.common",
        "--extra-packages org.librelab.dialer.app",
        "--extra-packages org.librelab.dialer.assisteddialing",
        "--extra-packages org.librelab.dialer.assisteddialing.ui",
        "--extra-packages org.librelab.dialer.blocking",
        "--extra-packages org.librelab.dialer.blockreportspam",
        "--extra-packages org.librelab.dialer.calldetails",
        "--extra-packages org.librelab.dialer.calllog.database",
        "--extra-packages org.librelab.dialer.calllog.ui",
        "--extra-packages org.librelab.dialer.calllog.ui.menu",
        "--extra-packages org.librelab.dialer.calllogutils",
        "--extra-packages org.librelab.dialer.clipboard",
        "--extra-packages org.librelab.dialer.common",
        "--extra-packages org.librelab.dialer.contactphoto",
        "--extra-packages org.librelab.dialer.contacts.displaypreference",
        "--extra-packages org.librelab.dialer.contacts.resources",
        "--extra-packages org.librelab.dialer.contactsfragment",
        "--extra-packages org.librelab.dialer.databasepopulator",
        "--extra-packages org.librelab.dialer.dialpadview",
        "--extra-packages org.librelab.dialer.dialpadview.theme",
        "--extra-packages org.librelab.dialer.glidephotomanager.impl",
        "--extra-packages org.librelab.dialer.historyitemactions",
        "--extra-packages org.librelab.dialer.interactions",
        "--extra-packages org.librelab.dialer.lettertile",
        "--extra-packages org.librelab.dialer.location",
        "--extra-packages org.librelab.dialer.main.impl",
        "--extra-packages org.librelab.dialer.main.impl.bottomnav",
        "--extra-packages org.librelab.dialer.main.impl.toolbar",
        "--extra-packages org.librelab.dialer.notification",
        "--extra-packages org.librelab.dialer.oem",
        "--extra-packages org.librelab.dialer.phonelookup.database",
        "--extra-packages org.librelab.dialer.phonenumberutil",
        "--extra-packages org.librelab.dialer.postcall",
        "--extra-packages org.librelab.dialer.precall.externalreceiver",
        "--extra-packages org.librelab.dialer.precall.impl",
        "--extra-packages org.librelab.dialer.preferredsim.impl",
        "--extra-packages org.librelab.dialer.preferredsim.suggestion",
        "--extra-packages org.librelab.dialer.promotion.impl",
        "--extra-packages org.librelab.dialer.rtt",
        "--extra-packages org.librelab.dialer.searchfragment.common",
        "--extra-packages org.librelab.dialer.searchfragment.cp2",
        "--extra-packages org.librelab.dialer.searchfragment.directories",
        "--extra-packages org.librelab.dialer.searchfragment.list",
        "--extra-packages org.librelab.dialer.searchfragment.nearbyplaces",
        "--extra-packages org.librelab.dialer.shortcuts",
        "--extra-packages org.librelab.dialer.simulator.impl",
        "--extra-packages org.librelab.dialer.simulator.service",
        "--extra-packages org.librelab.dialer.spannable",
        "--extra-packages org.librelab.dialer.speeddial",
        "--extra-packages org.librelab.dialer.theme",
        "--extra-packages org.librelab.dialer.theme.base",
        "--extra-packages org.librelab.dialer.theme.base.impl",
        "--extra-packages org.librelab.dialer.theme.common",
        "--extra-packages org.librelab.dialer.theme.hidden",
        "--extra-packages org.librelab.dialer.util",
        "--extra-packages org.librelab.dialer.voicemail.listui",
        "--extra-packages org.librelab.dialer.voicemail.listui.error",
        "--extra-packages org.librelab.dialer.voicemail.settings",
        "--extra-packages org.librelab.dialer.voicemailstatus",
        "--extra-packages org.librelab.dialer.widget",
        "--extra-packages org.librelab.incallui",
        "--extra-packages org.librelab.incallui.answer.impl",
        "--extra-packages org.librelab.incallui.answer.impl.affordance",
        "--extra-packages org.librelab.incallui.answer.impl.answermethod",
        "--extra-packages org.librelab.incallui.answer.impl.hint",
        "--extra-packages org.librelab.incallui.audioroute",
        "--extra-packages org.librelab.incallui.autoresizetext",
        "--extra-packages org.librelab.incallui.callpending",
        "--extra-packages org.librelab.incallui.commontheme",
        "--extra-packages org.librelab.incallui.contactgrid",
        "--extra-packages org.librelab.incallui.disconnectdialog",
        "--extra-packages org.librelab.incallui.hold",
        "--extra-packages org.librelab.incallui.incall.impl",
        "--extra-packages org.librelab.incallui.rtt.impl",
        "--extra-packages org.librelab.incallui.rtt.protocol",
        "--extra-packages org.librelab.incallui.sessiondata",
        "--extra-packages org.librelab.incallui.spam",
        "--extra-packages org.librelab.incallui.telecomeventui",
        "--extra-packages org.librelab.incallui.video.impl",
        "--extra-packages org.librelab.incallui.video.protocol",
        "--extra-packages org.librelab.voicemail",
        "--extra-packages org.librelab.voicemail.impl",
        "--extra-packages org.librelab.voicemail.impl.configui",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    certificate: ":libredialer_cert",
    exclude_srcs: ["java/org/librelab/dialer/rootcomponentgenerator/*.java"],
    libs: [
        "auto_value_annotations",
        "org.apache.http.legacy.stubs.system",
    ],
    optimize: {
        proguard_flags_files: [
            "java/org/librelab/dialer/common/proguard.flags",
            "java/org/librelab/dialer/proguard/proguard.flags",
            "java/org/librelab/dialer/proguard/proguard_base.flags",
            "java/org/librelab/dialer/proguard/proguard_release.flags",
            "java/org/librelab/incallui/answer/impl/proguard.flags",
            "java/org/librelab/voicemail/impl/proguard.flags",
            "proguard.flags",
        ],
    },
    optional_uses_libs: ["org.apache.http.legacy"],
    plugins: [
        "auto_value_plugin",
        "dagger2-compiler",
        "dialer-rootcomponentprocessor",
        "glide-annotation-processor",
    ],
    privileged: true,
    product_specific: true,
    required: [
        "privapp_whitelist_org.librelab.dialer",
        "privapp_whitelist_org.librelab.dialer-ext.xml",
    ],
    resource_dirs: [
        "assets/quantum/res",
        "java/org/librelab/contacts/common/res",
        "java/org/librelab/dialer/app/res",
        "java/org/librelab/dialer/assisteddialing/res",
        "java/org/librelab/dialer/assisteddialing/ui/res",
        "java/org/librelab/dialer/blocking/res",
        "java/org/librelab/dialer/blockreportspam/res",
        "java/org/librelab/dialer/calldetails/res",
        "java/org/librelab/dialer/calllog/ui/menu/res",
        "java/org/librelab/dialer/calllogutils/res",
        "java/org/librelab/dialer/callrecord/res",
        "java/org/librelab/dialer/callstats/res",
        "java/org/librelab/dialer/clipboard/res",
        "java/org/librelab/dialer/common/res",
        "java/org/librelab/dialer/contactphoto/res",
        "java/org/librelab/dialer/contacts/displaypreference/res",
        "java/org/librelab/dialer/contacts/resources/res",
        "java/org/librelab/dialer/contactsfragment/res",
        "java/org/librelab/dialer/dialpadview/res",
        "java/org/librelab/dialer/dialpadview/theme/res",
        "java/org/librelab/dialer/glidephotomanager/impl/res",
        "java/org/librelab/dialer/helplines/res",
        "java/org/librelab/dialer/historyitemactions/res",
        "java/org/librelab/dialer/interactions/res",
        "java/org/librelab/dialer/lettertile/res",
        "java/org/librelab/dialer/lookup/res",
        "java/org/librelab/dialer/main/impl/bottomnav/res",
        "java/org/librelab/dialer/main/impl/res",
        "java/org/librelab/dialer/main/impl/toolbar/res",
        "java/org/librelab/dialer/notification/res",
        "java/org/librelab/dialer/oem/res",
        "java/org/librelab/dialer/phonenumberutil/res",
        "java/org/librelab/dialer/postcall/res",
        "java/org/librelab/dialer/precall/impl/res",
        "java/org/librelab/dialer/preferredsim/impl/res",
        "java/org/librelab/dialer/preferredsim/suggestion/res",
        "java/org/librelab/dialer/promotion/impl/res",
        "java/org/librelab/dialer/rtt/res",
        "java/org/librelab/dialer/searchfragment/common/res",
        "java/org/librelab/dialer/searchfragment/cp2/res",
        "java/org/librelab/dialer/searchfragment/directories/res",
        "java/org/librelab/dialer/searchfragment/list/res",
        "java/org/librelab/dialer/searchfragment/nearbyplaces/res",
        "java/org/librelab/dialer/searchfragment/remote/res",
        "java/org/librelab/dialer/shortcuts/res",
        "java/org/librelab/dialer/spannable/res",
        "java/org/librelab/dialer/speeddial/res",
        "java/org/librelab/dialer/theme/base/res",
        "java/org/librelab/dialer/theme/common/res",
        "java/org/librelab/dialer/theme/hidden/res",
        "java/org/librelab/dialer/theme/res",
        "java/org/librelab/dialer/util/res",
        "java/org/librelab/dialer/voicemail/listui/error/res",
        "java/org/librelab/dialer/voicemail/listui/res",
        "java/org/librelab/dialer/voicemail/settings/res",
        "java/org/librelab/dialer/widget/res",
        "java/org/librelab/incallui/answer/impl/affordance/res",
        "java/org/librelab/incallui/answer/impl/answermethod/res",
        "java/org/librelab/incallui/answer/impl/res",
        "java/org/librelab/incallui/audioroute/res",
        "java/org/librelab/incallui/autoresizetext/res",
        "java/org/librelab/incallui/callpending/res",
        "java/org/librelab/incallui/commontheme/res",
        "java/org/librelab/incallui/contactgrid/res",
        "java/org/librelab/incallui/disconnectdialog/res",
        "java/org/librelab/incallui/hold/res",
        "java/org/librelab/incallui/incall/impl/res",
        "java/org/librelab/incallui/res",
        "java/org/librelab/incallui/rtt/impl/res",
        "java/org/librelab/incallui/sessiondata/res",
        "java/org/librelab/incallui/spam/res",
        "java/org/librelab/incallui/telecomeventui/res",
        "java/org/librelab/incallui/theme/res",
        "java/org/librelab/incallui/video/impl/res",
        "java/org/librelab/incallui/video/protocol/res",
        "java/org/librelab/voicemail/impl/configui/res",
        "java/org/librelab/voicemail/impl/res",
    ],
    sdk_version: "system_current",
    srcs: [
        "java/**/I*.aidl",
        "java/**/*.java",
    ],
    static_libs: [
        "android-common",
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.cardview_cardview",
        "androidx.collection_collection",
        "androidx.coordinatorlayout_coordinatorlayout",
        "androidx.dynamicanimation_dynamicanimation",
        "androidx.exifinterface_exifinterface",
        "androidx.fragment_fragment",
        "androidx.localbroadcastmanager_localbroadcastmanager",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "apache-commons-compress",
        "com.google.android.material_material",
        "dagger2",
        "dialer-apache-mime4j-core",
        "dialer-apache-mime4j-dom",
        "dialer-commons-io",
        "dialer-protos",
        "error_prone_annotations",
        "glide-annotation-and-compiler-prebuilt",
        "glide-disklrucache-prebuilt",
        "glide-gifdecoder-prebuilt",
        "glide-prebuilt",
        "guava",
        "jsr305",
        "jsr330",
        "libphonenumber",
        "org.lineageos.lib.phone",
        "volley",
    ],
    use_embedded_native_libs: true,
}

java_library {
    name: "dialer-protos",
    proto: {
        canonical_path_from_root: false,
        type: "lite",
    },
    sdk_version: "system_current",
    srcs: ["java/**/*.proto",],
    static_libs: ["libprotobuf-java-lite"],
}

java_plugin {
    name: "dialer-rootcomponentprocessor",
    processor_class: "org.librelab.dialer.rootcomponentgenerator.RootComponentProcessor",
    srcs: [
        "java/org/librelab/dialer/rootcomponentgenerator/*.java",
        "java/org/librelab/dialer/inject/HasRootComponent.java",
        "java/org/librelab/dialer/inject/IncludeInDialerRoot.java",
        "java/org/librelab/dialer/inject/RootComponentGeneratorMetadata.java",
    ],
    static_libs: [
        "auto_common",
        "auto_service_annotations",
        "dagger2",
        "guava",
        "javapoet",
        "jsr330",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.librelab.dialer",
    product_specific: true,
    src: "privapp_whitelist_org.librelab.dialer.xml",
    sub_dir: "permissions",
}

prebuilt_etc {
    name: "privapp_whitelist_org.librelab.dialer-ext.xml",
    product_specific: true,
    src: "privapp_whitelist_org.librelab.dialer-ext.xml",
    sub_dir: "permissions",
}
